{%- comment -%} Marlowe — seasonal drop (featured collection, 3-card grid) {%- endcomment -%}
<section data-section="seasonal-candles" style="background:{{ section.settings.bg }};padding:82px 44px;">
  <div style="max-width:1000px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:40px;">
      {%- if section.settings.eyebrow != blank -%}<span style="display:inline-block;background:#5B4373;color:#FDF3EA;font-family:'Space Mono',monospace;font-size:12px;letter-spacing:.16em;text-transform:uppercase;padding:7px 16px;border-radius:999px;margin-bottom:18px;">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 style="font-family:'DM Serif Display',serif;font-style:italic;font-weight:400;color:#5B4373;font-size:44px;line-height:1.05;margin:0 0 14px;">{{ section.settings.heading }}</h2>
      <p style="color:#3F3F3D;font-size:14.5px;line-height:1.7;margin:0 auto;max-width:460px;">{{ section.settings.subheading }}</p>
    </div>
    <div class="mb-cards mb-cards--3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }} style="background:#FFFFFF;border-radius:20px;padding:16px 16px 24px;display:flex;flex-direction:column;">
          <div style="border-radius:14px;aspect-ratio:.9;background:{{ block.settings.image_bg }};display:flex;align-items:center;justify-content:center;background-image:repeating-linear-gradient(45deg,rgba(91,67,115,.07) 0 12px,transparent 12px 24px);margin-bottom:16px;position:relative;overflow:hidden;">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;">
            {%- endif -%}
            {%- if block.settings.badge != blank -%}
              <span style="position:absolute;top:12px;left:12px;background:#5B4373;color:#FDF3EA;font-size:9px;letter-spacing:.12em;text-transform:uppercase;padding:5px 10px;border-radius:999px;">{{ block.settings.badge }}</span>
            {%- endif -%}
          </div>
          <h3 style="font-family:'DM Serif Display',serif;font-weight:400;color:#5B4373;font-size:23px;margin:0 0 6px;">{{ block.settings.title }}</h3>
          <p style="color:#3F3F3D;font-size:13px;line-height:1.55;margin:0 0 18px;flex:1;">{{ block.settings.description }}</p>
          <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;">
            <span style="color:#5B4373;font-family:'Space Mono',monospace;font-weight:700;font-size:16.5px;">{{ block.settings.price }}</span>
            <a href="{{ block.settings.link | default: '#' }}" style="background:#5B4373;color:#FDF3EA;font-size:11px;letter-spacing:.14em;text-transform:uppercase;padding:10px 16px;border-radius:999px;">{{ section.settings.button_label }}</a>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- if section.settings.show_wave -%}
<div style="background:{{ section.settings.bg }};line-height:0;">
  <svg viewBox="0 0 1440 60" preserveAspectRatio="none" style="display:block;width:100%;height:52px;"><path fill="{{ section.settings.wave_color }}" d="M0,60 L0,30 Q60,0 120,30 T240,30 T360,30 T480,30 T600,30 T720,30 T840,30 T960,30 T1080,30 T1200,30 T1320,30 T1440,30 L1440,60 Z"></path></svg>
</div>
{%- endif -%}

<style>
  @media screen and (max-width: 749px) { #shopify-section-{{ section.id }} .mb-cards--3 { grid-template-columns: 1fr !important; } }
</style>

{% schema %}
{
  "name": "Seasonal drop",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow pill", "default": "Limited edition · Summer" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The summer candle drop" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Three scents, hand-poured in tiny batches once a season. When this batch sells out, that's it until next year — so grab yours while they're here." },
    { "type": "text", "id": "button_label", "label": "Card button label", "default": "Add to cart" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#E4EFD1" },
    { "type": "header", "content": "Bottom wave" },
    { "type": "checkbox", "id": "show_wave", "label": "Show bottom wave", "default": true },
    { "type": "color", "id": "wave_color", "label": "Wave color (next section bg)", "default": "#5B4373" }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "color", "id": "image_bg", "label": "Image placeholder color", "default": "#D8C4F0" },
        { "type": "text", "id": "badge", "label": "Badge", "default": "Limited" },
        { "type": "text", "id": "title", "label": "Title", "default": "Candle name" },
        { "type": "text", "id": "description", "label": "Description", "default": "Scent notes and burn time." },
        { "type": "text", "id": "price", "label": "Price", "default": "$28" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Seasonal drop",
      "blocks": [
        { "type": "product_card", "settings": { "image_bg": "#D8C4F0", "badge": "Limited", "title": "Fig & Cedar", "description": "Warm fig, cedarwood, and a whisper of smoke. ~45hr burn.", "price": "$28" } },
        { "type": "product_card", "settings": { "image_bg": "#D9E8C0", "badge": "Limited", "title": "Lavender Fields", "description": "Fresh lavender, bergamot, and soft white musk. ~45hr burn.", "price": "$28" } },
        { "type": "product_card", "settings": { "image_bg": "#E4EFD1", "badge": "Limited", "title": "Sea Salt & Sage", "description": "Sea salt, garden sage, and sun-warmed driftwood. ~45hr burn.", "price": "$28" } }
      ]
    }
  ]
}
{% endschema %}
