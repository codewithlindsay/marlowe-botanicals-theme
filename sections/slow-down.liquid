{%- comment -%} Marlowe — slow down (image with text + checklist) {%- endcomment -%}
<section data-section="slow-down" style="background:{{ section.settings.bg }};padding:76px 44px;">
  <div class="mb-split" style="max-width:1180px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:52px;align-items:center;">
    <div style="position:relative;">
      <div style="border-radius:30px;overflow:hidden;background:#E4EFD1;aspect-ratio:1.05;display:flex;align-items:center;justify-content:center;background-image:repeating-linear-gradient(45deg,rgba(91,67,115,.07) 0 14px,transparent 14px 28px);">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy" style="width:100%;height:100%;object-fit:cover;">
        {%- else -%}
          <span style="font-family:'Space Mono',monospace;font-size:12px;color:#5B4373;text-align:center;">watering a<br>houseplant</span>
        {%- endif -%}
      </div>
      <div class="mb-slow__tag" style="position:absolute;top:38%;left:-30px;width:96px;height:64px;border-radius:0 0 48px 48px;background:#5B4373;background-image:repeating-linear-gradient(0deg,rgba(224,203,245,.18) 0 6px,transparent 6px 12px);display:flex;align-items:flex-end;justify-content:center;padding-bottom:8px;">
        <span style="font-family:'Space Mono',monospace;font-size:9px;color:#E8D8F8;">{{ section.settings.tag_text }}</span>
      </div>
    </div>
    <div style="background:#FFFFFF;border-radius:30px;padding:46px 44px;">
      <h2 style="font-family:'DM Serif Display',serif;font-style:italic;font-weight:400;color:#5B4373;font-size:38px;line-height:1.08;margin:0 0 22px;">{{ section.settings.heading }}</h2>
      <p style="color:#3F3F3D;font-size:13px;line-height:1.7;margin:0 0 18px;">{{ section.settings.intro }}</p>
      <ul style="list-style:none;margin:0 0 28px;padding:0;display:flex;flex-direction:column;gap:14px;">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }} style="color:#3F3F3D;font-size:13px;line-height:1.6;padding-left:22px;position:relative;"><span style="position:absolute;left:0;top:0;color:#A9CC7B;">✦</span>{{ block.settings.text }}</li>
        {%- endfor -%}
      </ul>
      {%- if section.settings.button_text != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" style="display:inline-block;background:#A9CC7B;color:#3F3F3D;font-size:12px;letter-spacing:.16em;text-transform:uppercase;padding:14px 26px;border-radius:999px;">{{ section.settings.button_text }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .mb-split { grid-template-columns: 1fr !important; gap: 32px !important; }
    #shopify-section-{{ section.id }} .mb-slow__tag { left: 12px !important; }
  }
</style>

{% schema %}
{
  "name": "Slow down",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "tag_text", "label": "Floating tag text", "default": "bowl" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Slow down, on purpose." },
    { "type": "textarea", "id": "intro", "label": "Intro text", "default": "Aromatherapy isn't about fixing yourself — it's about making space to rest. Here's what that looks like in practice:" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Learn more" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FDF3EA" }
  ],
  "blocks": [
    { "type": "item", "name": "Checklist item", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "A benefit worth listing." } ] }
  ],
  "presets": [
    {
      "name": "Slow down",
      "blocks": [
        { "type": "item", "settings": { "text": "Blended with pure essential oils — no synthetic fragrance, ever." } },
        { "type": "item", "settings": { "text": "Grounding rituals that fit into five quiet minutes a day." } },
        { "type": "item", "settings": { "text": "Massage techniques you can practice at home between sessions." } },
        { "type": "item", "settings": { "text": "Sourced ethically and made in small batches, in-studio." } }
      ]
    }
  ]
}
{% endschema %}
