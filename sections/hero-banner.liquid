{%- comment -%} Marlowe — hero banner (image-banner) {%- endcomment -%}
<section data-section="hero-banner" style="background:{{ section.settings.bg }};padding:52px 44px 88px;position:relative;overflow:hidden;">
  <div style="position:absolute;top:24px;left:36px;pointer-events:none;z-index:3;">
    <svg width="54" height="54" viewBox="0 0 40 40" style="display:block;"><g fill="#FFFFFF"><circle cx="20" cy="12" r="6.6"></circle><circle cx="28" cy="20" r="6.6"></circle><circle cx="20" cy="28" r="6.6"></circle><circle cx="12" cy="20" r="6.6"></circle></g><circle cx="20" cy="20" r="4.2" fill="#A9CC7B"></circle></svg>
    <svg width="34" height="34" viewBox="0 0 40 40" style="display:block;margin:-6px 0 0 42px;"><g fill="#FFFFFF"><circle cx="20" cy="12" r="6.6"></circle><circle cx="28" cy="20" r="6.6"></circle><circle cx="20" cy="28" r="6.6"></circle><circle cx="12" cy="20" r="6.6"></circle></g><circle cx="20" cy="20" r="4.2" fill="#A9CC7B"></circle></svg>
  </div>
  <div style="max-width:1180px;margin:0 auto;position:relative;">
    <div class="mb-hero__circle" style="position:absolute;top:14px;right:0;width:min({{ section.settings.image_size }}px,{{ section.settings.image_size_vw }}vw);aspect-ratio:1;border-radius:50%;background:#A9CC7B;display:flex;align-items:center;justify-content:center;overflow:hidden;background-image:repeating-linear-gradient(45deg,rgba(63,63,61,.08) 0 14px,transparent 14px 28px);z-index:1;">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.image.alt | escape }}" loading="eager" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" style="width:100%;height:100%;object-fit:cover;">
      {%- else -%}
        <span style="font-family:'Space Mono',monospace;font-size:12px;color:#3F3F3D;text-align:center;">Hero image —<br>oils &amp; botanicals</span>
      {%- endif -%}
    </div>
    <div class="mb-hero__tag" style="position:absolute;top:min(430px,42vw);right:min(410px,36vw);width:118px;height:118px;border-radius:26px;transform:rotate(-8deg);background:#5B4373;background-image:repeating-linear-gradient(-45deg,rgba(232,216,248,.16) 0 10px,transparent 10px 20px);display:flex;align-items:center;justify-content:center;z-index:2;">
      <span style="font-family:'Space Mono',monospace;font-size:10px;color:#E8D8F8;text-align:center;">{{ section.settings.tag_text }}</span>
    </div>
    <div style="position:relative;z-index:2;padding-top:64px;">
      <h1 style="font-family:'DM Serif Display',serif;font-weight:400;color:#5B4373;margin:0;font-size:clamp({{ section.settings.heading_min }}px,13vw,{{ section.settings.heading_max }}px);line-height:.86;letter-spacing:-.02em;">
        {{ section.settings.line_1 }}<br><span style="font-style:italic;">{{ section.settings.line_2 }}</span><br>{{ section.settings.line_3 }}
      </h1>
      <p style="max-width:400px;color:#5B4373;font-size:14px;line-height:1.75;margin:36px 0 28px;">{{ section.settings.body }}</p>
      <div style="display:flex;gap:14px;flex-wrap:wrap;">
        {%- if section.settings.button_1_text != blank -%}<a href="{{ section.settings.button_1_link | default: '#' }}" style="display:inline-block;background:#5B4373;color:#FDF3EA;font-size:13px;letter-spacing:.16em;text-transform:uppercase;padding:16px 30px;border-radius:999px;">{{ section.settings.button_1_text }}</a>{%- endif -%}
        {%- if section.settings.button_2_text != blank -%}<a href="{{ section.settings.button_2_link | default: '#' }}" style="display:inline-block;border:2px solid #5B4373;color:#5B4373;font-size:13px;letter-spacing:.16em;text-transform:uppercase;padding:15px 28px;border-radius:999px;">{{ section.settings.button_2_text }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  @media screen and (max-width: 900px) {
    #shopify-section-{{ section.id }} .mb-hero__circle { position: static !important; width: 100% !important; max-width: 420px; margin: 32px auto 0; }
    #shopify-section-{{ section.id }} .mb-hero__tag { display: none !important; }
  }
</style>

{% schema %}
{
  "name": "Hero banner",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "range", "id": "image_size", "min": 280, "max": 680, "step": 10, "unit": "px", "label": "Hero circle size (max)", "default": 500 },
    { "type": "range", "id": "image_size_vw", "min": 28, "max": 60, "step": 1, "unit": "%", "label": "Hero circle size (scales with screen width)", "info": "The circle shows whichever of the two is smaller, so it never overflows.", "default": 44 },
    { "type": "text", "id": "line_1", "label": "Heading line 1", "default": "Essential" },
    { "type": "text", "id": "line_2", "label": "Heading line 2 (italic)", "default": "oils &" },
    { "type": "text", "id": "line_3", "label": "Heading line 3", "default": "rituals" },
    { "type": "range", "id": "heading_max", "min": 80, "max": 240, "step": 4, "unit": "px", "label": "Heading size — desktop (max)", "default": 176 },
    { "type": "range", "id": "heading_min", "min": 40, "max": 120, "step": 2, "unit": "px", "label": "Heading size — mobile (min)", "default": 72 },
    { "type": "textarea", "id": "body", "label": "Body text", "default": "Small-batch botanical oils and massage therapy for a body that needs to slow down. Pure ingredients, gentle rituals — a little calm you can hold in your hands." },
    { "type": "text", "id": "tag_text", "label": "Floating tag text", "default": "hand / product" },
    { "type": "text", "id": "button_1_text", "label": "Button 1 text", "default": "Shop now" },
    { "type": "url", "id": "button_1_link", "label": "Button 1 link" },
    { "type": "text", "id": "button_2_text", "label": "Button 2 text", "default": "Book a session" },
    { "type": "url", "id": "button_2_link", "label": "Button 2 link" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#E8D8F8" }
  ],
  "presets": [{ "name": "Hero banner" }]
}
{% endschema %}
