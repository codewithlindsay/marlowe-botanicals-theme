{%- comment -%} Marlowe — founder quote (centered, or split with round photo) {%- endcomment -%}
<section data-section="founder-quote" style="background:{{ section.settings.bg }};padding:88px 44px;">
  {%- if section.settings.layout == 'split' -%}
    <div class="mb-quote mb-quote--split" style="max-width:1120px;margin:0 auto;display:grid;grid-template-columns:1.1fr .9fr;gap:56px;align-items:center;">
      <div>
        <p style="font-family:'DM Serif Display',serif;font-style:italic;color:#FFFFFF;font-size:clamp(26px,3.4vw,40px);line-height:1.25;margin:0 0 24px;">"{{ section.settings.quote }}"</p>
        <p style="font-family:'Space Mono',monospace;font-size:13px;letter-spacing:.16em;text-transform:uppercase;color:#E8D8F8;margin:0;">{{ section.settings.attribution }}</p>
      </div>
      <div class="mb-quote__media" style="position:relative;width:100%;max-width:{{ section.settings.image_size }}px;justify-self:center;">
        <div style="width:100%;aspect-ratio:1;border-radius:50%;overflow:hidden;background:#E8D8F8;display:flex;align-items:center;justify-content:center;background-image:repeating-linear-gradient(45deg,rgba(91,67,115,.12) 0 16px,transparent 16px 32px);">
          {%- if section.settings.image != blank -%}
            <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" style="width:100%;height:100%;object-fit:cover;">
          {%- else -%}
            <span style="font-family:'Space Mono',monospace;font-size:13px;color:#5B4373;text-align:center;">founder<br>portrait</span>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- else -%}
    <div style="max-width:760px;margin:0 auto;text-align:center;">
      <p style="font-family:'DM Serif Display',serif;font-style:italic;color:#FFFFFF;font-size:clamp(26px,4vw,38px);line-height:1.3;margin:0 0 24px;">"{{ section.settings.quote }}"</p>
      <p style="font-family:'Space Mono',monospace;font-size:13px;letter-spacing:.16em;text-transform:uppercase;color:#E8D8F8;margin:0;">{{ section.settings.attribution }}</p>
    </div>
  {%- endif -%}
</section>

<style>
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .mb-quote--split { grid-template-columns: 1fr !important; gap: 36px !important; text-align: center; }
    #shopify-section-{{ section.id }} .mb-quote--split .mb-quote__media { order: -1; max-width: 300px !important; }
  }
</style>

{% schema %}
{
  "name": "Founder quote",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "centered",
      "options": [
        { "value": "centered", "label": "Centered quote" },
        { "value": "split", "label": "Split — quote left, photo right" }
      ]
    },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "Rest isn't something you earn at the end of the day. It's something you're allowed to reach for any time." },
    { "type": "text", "id": "attribution", "label": "Attribution", "default": "— Marlowe, founder" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#5B4373" },
    { "type": "header", "content": "Split layout photo" },
    { "type": "image_picker", "id": "image", "label": "Round photo", "info": "Shown on the right when Layout is set to Split." },
    { "type": "range", "id": "image_size", "min": 220, "max": 560, "step": 4, "unit": "px", "label": "Photo size (max)", "default": 380 }
  ],
  "presets": [{ "name": "Founder quote" }]
}
{% endschema %}
