{%- comment -%} Marlowe — founder quote (rich text) {%- endcomment -%}
<section data-section="founder-quote" style="background:{{ section.settings.bg }};padding:88px 44px;">
  <div style="max-width:760px;margin:0 auto;text-align:center;">
    <p style="font-family:'DM Serif Display',serif;font-style:italic;color:#FFFFFF;font-size:clamp(26px,4vw,38px);line-height:1.3;margin:0 0 24px;">"{{ section.settings.quote }}"</p>
    <p style="font-family:'Space Mono',monospace;font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:#E8D8F8;margin:0;">{{ section.settings.attribution }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Founder quote",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "Rest isn't something you earn at the end of the day. It's something you're allowed to reach for any time." },
    { "type": "text", "id": "attribution", "label": "Attribution", "default": "— Marlowe, founder" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#5B4373" }
  ],
  "presets": [{ "name": "Founder quote" }]
}
{% endschema %}
