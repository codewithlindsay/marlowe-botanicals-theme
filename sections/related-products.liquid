{%- comment -%} Marlowe — related products ("Pairs well with") {%- endcomment -%}
<section data-section="related-products" style="background:{{ section.settings.bg }};padding:72px 44px;">
  <div style="max-width:1180px;margin:0 auto;">
    <h2 style="font-family:'DM Serif Display',serif;font-style:italic;font-weight:400;color:#5B4373;font-size:34px;margin:0 0 32px;text-align:center;">{{ section.settings.heading }}</h2>
    <div class="mb-cards mb-cards--3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;">
      {%- assign shown = 0 -%}
      {%- assign source = product.collections.first.products | default: section.settings.collection.products -%}
      {%- if source and source.size > 0 -%}
        {%- for p in source -%}
          {%- if p.id == product.id -%}{%- continue -%}{%- endif -%}
          {%- if shown >= 3 -%}{%- break -%}{%- endif -%}
          {%- assign shown = shown | plus: 1 -%}
          <a href="{{ p.url }}" style="background:#FFFFFF;border-radius:20px;padding:16px 16px 22px;display:flex;flex-direction:column;color:#5B4373;">
            <div style="border-radius:14px;aspect-ratio:.9;overflow:hidden;background:#D9E8C0;display:flex;align-items:center;justify-content:center;background-image:repeating-linear-gradient(45deg,rgba(91,67,115,.07) 0 12px,transparent 12px 24px);margin-bottom:16px;">
              {%- if p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 600 }}" alt="{{ p.title | escape }}" loading="lazy" width="{{ p.featured_image.width }}" height="{{ p.featured_image.height }}" style="width:100%;height:100%;object-fit:cover;">{%- else -%}<span style="font-family:'Space Mono',monospace;font-size:11px;color:#5B4373;">product shot</span>{%- endif -%}
            </div>
            <h3 style="font-family:'DM Serif Display',serif;font-weight:400;color:#5B4373;font-size:20px;margin:0 0 6px;">{{ p.title }}</h3>
            <p style="color:#3F3F3D;font-size:12px;line-height:1.55;margin:0 0 16px;flex:1;">{{ p.description | strip_html | truncatewords: 12 }}</p>
            <span style="color:#5B4373;font-family:'Space Mono',monospace;font-weight:700;font-size:15px;">{{ p.price | money }}</span>
          </a>
        {%- endfor -%}
      {%- endif -%}
      {%- if shown == 0 -%}
        {%- assign fallbacks = 'Muscle Melt Massage Oil|Warming blend for tired, knotted muscles.|$32|#D9E8C0,Eucalyptus Breathe Roll-On|Clear the head and open the chest, on the go.|$18|#D8C4F0,Sweet Almond Carrier Oil|Silky, unscented base for your own blends.|$16|#E4EFD1' | split: ',' -%}
        {%- for f in fallbacks -%}
          {%- assign parts = f | split: '|' -%}
          <a href="#" style="background:#FFFFFF;border-radius:20px;padding:16px 16px 22px;display:flex;flex-direction:column;color:#5B4373;">
            <div style="border-radius:14px;aspect-ratio:.9;background:{{ parts[3] }};display:flex;align-items:center;justify-content:center;background-image:repeating-linear-gradient(45deg,rgba(91,67,115,.07) 0 12px,transparent 12px 24px);margin-bottom:16px;"><span style="font-family:'Space Mono',monospace;font-size:11px;color:#5B4373;">product shot</span></div>
            <h3 style="font-family:'DM Serif Display',serif;font-weight:400;color:#5B4373;font-size:20px;margin:0 0 6px;">{{ parts[0] }}</h3>
            <p style="color:#3F3F3D;font-size:12px;line-height:1.55;margin:0 0 16px;flex:1;">{{ parts[1] }}</p>
            <span style="color:#5B4373;font-family:'Space Mono',monospace;font-weight:700;font-size:15px;">{{ parts[2] }}</span>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  @media screen and (max-width: 749px) { #shopify-section-{{ section.id }} .mb-cards--3 { grid-template-columns: 1fr !important; } }
</style>

{% schema %}
{
  "name": "Related products",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pairs well with" },
    { "type": "collection", "id": "collection", "label": "Fallback collection (if product has none)" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#E4EFD1" }
  ],
  "presets": [{ "name": "Related products" }]
}
{% endschema %}
