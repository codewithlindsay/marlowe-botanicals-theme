{%- comment -%} Marlowe — story (hero-style, swapped: circle image left, text right, overlapping tile) {%- endcomment -%}
<section data-section="story" style="background:{{ section.settings.bg }};padding:80px 44px;">
  <div class="mb-story" style="max-width:1180px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;">
    <div class="mb-story__media" style="position:relative;width:100%;max-width:{{ section.settings.image_size }}px;justify-self:center;">
      <div style="width:100%;aspect-ratio:1;border-radius:50%;overflow:hidden;background:#E4EFD1;display:flex;align-items:center;justify-content:center;background-image:repeating-linear-gradient(45deg,rgba(91,67,115,.07) 0 16px,transparent 16px 32px);">
        {%- if section.settings.image_1 != blank -%}
          <img src="{{ section.settings.image_1 | image_url: width: 1000 }}" alt="{{ section.settings.image_1.alt | escape }}" loading="lazy" width="{{ section.settings.image_1.width }}" height="{{ section.settings.image_1.height }}" style="width:100%;height:100%;object-fit:cover;">
        {%- else -%}
          <span style="font-family:'Space Mono',monospace;font-size:12px;color:#5B4373;text-align:center;">photo —<br>Marlowe in the studio</span>
        {%- endif -%}
      </div>
      <div class="mb-story__tile" style="position:absolute;right:-6%;bottom:8%;width:{{ section.settings.tile_size }}px;aspect-ratio:1;border-radius:20px;transform:rotate(-6deg);overflow:hidden;background:#E8D8F8;display:flex;align-items:center;justify-content:center;background-image:repeating-linear-gradient(45deg,rgba(91,67,115,.08) 0 12px,transparent 12px 24px);">
        {%- if section.settings.image_2 != blank -%}
          <img src="{{ section.settings.image_2 | image_url: width: 500 }}" alt="{{ section.settings.image_2.alt | escape }}" loading="lazy" width="{{ section.settings.image_2.width }}" height="{{ section.settings.image_2.height }}" style="width:100%;height:100%;object-fit:cover;">
        {%- else -%}
          <span style="font-family:'Space Mono',monospace;font-size:10px;color:#5B4373;text-align:center;">oils on<br>the bench</span>
        {%- endif -%}
      </div>
    </div>
    <div class="mb-story__text">
      <h2 style="font-family:'DM Serif Display',serif;font-style:italic;font-weight:400;color:#5B4373;font-size:clamp(34px,4vw,48px);line-height:1.05;margin:0 0 22px;">{{ section.settings.heading }}</h2>
      <p style="color:#3F3F3D;font-size:14px;line-height:1.8;margin:0 0 16px;max-width:440px;">{{ section.settings.paragraph_1 }}</p>
      <p style="color:#3F3F3D;font-size:14px;line-height:1.8;margin:0;max-width:440px;">{{ section.settings.paragraph_2 }}</p>
      {%- if section.settings.button_text != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" style="display:inline-block;margin-top:26px;background:#A9CC7B;color:#3F3F3D;font-size:12px;letter-spacing:.16em;text-transform:uppercase;padding:14px 28px;border-radius:999px;">{{ section.settings.button_text }}</a>
      {%- endif -%}
    </div>
  </div>
</section>
{%- if section.settings.show_wave -%}
<div style="background:{{ section.settings.bg }};line-height:0;">
  <svg viewBox="0 0 1440 60" preserveAspectRatio="none" style="display:block;width:100%;height:52px;"><path fill="{{ section.settings.wave_color }}" d="M0,60 L0,30 Q60,0 120,30 T240,30 T360,30 T480,30 T600,30 T720,30 T840,30 T960,30 T1080,30 T1200,30 T1320,30 T1440,30 L1440,60 Z"></path></svg>
</div>
{%- endif -%}

<style>
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .mb-story { grid-template-columns: 1fr !important; gap: 40px !important; }
    #shopify-section-{{ section.id }} .mb-story__media { max-width: 360px !important; }
    #shopify-section-{{ section.id }} .mb-story__text { text-align: center; }
    #shopify-section-{{ section.id }} .mb-story__text p { margin-left: auto; margin-right: auto; }
  }
</style>

{% schema %}
{
  "name": "Story",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image_1", "label": "Main circle photo" },
    { "type": "range", "id": "image_size", "min": 260, "max": 620, "step": 4, "unit": "px", "label": "Circle size (max)", "default": 460 },
    { "type": "image_picker", "id": "image_2", "label": "Small tile photo" },
    { "type": "range", "id": "tile_size", "min": 90, "max": 260, "step": 2, "unit": "px", "label": "Tile size", "default": 150 },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How it started" },
    { "type": "textarea", "id": "paragraph_1", "label": "Paragraph 1", "default": "After years as a massage therapist, I kept sending clients home wishing they could bottle the calm from the table. So I learned to. First for friends, then a tiny market stall, then this." },
    { "type": "textarea", "id": "paragraph_2", "label": "Paragraph 2", "default": "Today every product is blended in small batches, tested on my own tired shoulders, and made with ingredients I can trace back to the grower. No shortcuts, no synthetic fragrance — just plants doing what they do best." },
    { "type": "text", "id": "button_text", "label": "Button text", "info": "Leave blank to hide the button." },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FDF3EA" },
    { "type": "header", "content": "Bottom wave" },
    { "type": "checkbox", "id": "show_wave", "label": "Show bottom wave", "default": true },
    { "type": "color", "id": "wave_color", "label": "Wave color (next section bg)", "default": "#E4EFD1" }
  ],
  "presets": [{ "name": "Story" }]
}
{% endschema %}
