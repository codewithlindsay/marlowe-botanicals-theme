{%- comment -%} Marlowe — booking / contact form {%- endcomment -%}
<section data-section="booking-form" style="background:{{ section.settings.bg }};padding:72px 44px 88px;">
  <div class="mb-booking" style="max-width:1120px;margin:0 auto;display:grid;grid-template-columns:1.2fr .8fr;gap:48px;align-items:start;">

    <div style="background:#FFFFFF;border-radius:26px;padding:44px 46px;">
      <h2 style="font-family:'DM Serif Display',serif;font-style:italic;font-weight:400;color:#5B4373;font-size:30px;margin:0 0 26px;">{{ section.settings.form_heading }}</h2>
      {%- form 'contact', id: 'mb-booking-form' -%}
        <div style="display:flex;flex-direction:column;gap:18px;">
          {%- if form.posted_successfully? -%}
            <p style="background:#E4EFD1;color:#5B4373;border-radius:10px;padding:14px 16px;font-size:13px;margin:0;">{{ section.settings.success_text }}</p>
          {%- endif -%}
          {%- if form.errors -%}
            <p style="background:#F6DADA;color:#8a2b2b;border-radius:10px;padding:14px 16px;font-size:13px;margin:0;">{{ form.errors | default_errors }}</p>
          {%- endif -%}
          <div>
            <label style="display:block;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#5B4373;margin-bottom:8px;">Service</label>
            <select name="contact[Service]" style="width:100%;font-size:13px;color:#3F3F3D;background:#FFFFFF;border:1.5px solid #C9B3E8;border-radius:10px;padding:14px 16px;">
              {%- assign services = section.settings.services | newline_to_br | split: '<br />' -%}
              {%- for s in services -%}<option>{{ s | strip }}</option>{%- endfor -%}
            </select>
          </div>
          <div class="mb-booking__row" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
            <div>
              <label style="display:block;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#5B4373;margin-bottom:8px;">Preferred date</label>
              <input type="date" name="contact[Preferred date]" style="width:100%;font-size:13px;color:#3F3F3D;background:#FFFFFF;border:1.5px solid #C9B3E8;border-radius:10px;padding:13px 16px;">
            </div>
            <div>
              <label style="display:block;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#5B4373;margin-bottom:8px;">Preferred time</label>
              <select name="contact[Preferred time]" style="width:100%;font-size:13px;color:#3F3F3D;background:#FFFFFF;border:1.5px solid #C9B3E8;border-radius:10px;padding:14px 16px;">
                <option>Morning (9–12)</option>
                <option>Afternoon (12–4)</option>
                <option>Evening (4–7)</option>
              </select>
            </div>
          </div>
          <div class="mb-booking__row" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
            <div>
              <label style="display:block;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#5B4373;margin-bottom:8px;">Name</label>
              <input type="text" name="contact[name]" placeholder="Your name" style="width:100%;font-size:13px;color:#3F3F3D;background:#FFFFFF;border:1.5px solid #C9B3E8;border-radius:10px;padding:14px 16px;">
            </div>
            <div>
              <label style="display:block;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#5B4373;margin-bottom:8px;">Email</label>
              <input type="email" name="contact[email]" required placeholder="you@email.com" style="width:100%;font-size:13px;color:#3F3F3D;background:#FFFFFF;border:1.5px solid #C9B3E8;border-radius:10px;padding:14px 16px;">
            </div>
          </div>
          <div>
            <label style="display:block;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#5B4373;margin-bottom:8px;">Anything I should know?</label>
            <textarea name="contact[body]" rows="4" placeholder="Injuries, pressure preferences, scents to avoid…" style="width:100%;font-size:13px;color:#3F3F3D;background:#FFFFFF;border:1.5px solid #C9B3E8;border-radius:10px;padding:14px 16px;resize:vertical;"></textarea>
          </div>
          <button type="submit" style="background:#5B4373;color:#FDF3EA;border:none;font-size:13px;letter-spacing:.16em;text-transform:uppercase;padding:17px;border-radius:999px;cursor:pointer;margin-top:4px;">{{ section.settings.submit_text }}</button>
          <p style="color:#5B4373;font-size:10px;letter-spacing:.12em;text-transform:uppercase;text-align:center;margin:2px 0 0;">{{ section.settings.disclaimer }}</p>
        </div>
      {%- endform -%}
    </div>

    <div style="display:flex;flex-direction:column;gap:20px;">
      <div style="background:#E4EFD1;border-radius:22px;padding:30px 32px;">
        <h3 style="font-family:'DM Serif Display',serif;font-weight:400;color:#5B4373;font-size:22px;margin:0 0 16px;">{{ section.settings.hours_heading }}</h3>
        <div style="display:flex;flex-direction:column;gap:8px;font-size:13px;color:#3F3F3D;">
          {%- assign rows = section.settings.hours | newline_to_br | split: '<br />' -%}
          {%- for row in rows -%}
            {%- assign cells = row | split: '|' -%}
            <div style="display:flex;justify-content:space-between;"><span>{{ cells[0] | strip }}</span><span>{{ cells[1] | strip }}</span></div>
          {%- endfor -%}
        </div>
      </div>
      <div style="background:#E8D8F8;border-radius:22px;padding:30px 32px;">
        <h3 style="font-family:'DM Serif Display',serif;font-weight:400;color:#5B4373;font-size:22px;margin:0 0 14px;">{{ section.settings.find_heading }}</h3>
        <div style="border-radius:14px;aspect-ratio:1.6;overflow:hidden;background:#FFFFFF;display:flex;align-items:center;justify-content:center;background-image:repeating-linear-gradient(45deg,rgba(91,67,115,.07) 0 12px,transparent 12px 24px);margin-bottom:16px;">
          {%- if section.settings.map_image != blank -%}
            <img src="{{ section.settings.map_image | image_url: width: 700 }}" alt="Studio map" loading="lazy" style="width:100%;height:100%;object-fit:cover;">
          {%- else -%}
            <span style="font-family:'Space Mono',monospace;font-size:11px;color:#5B4373;">map</span>
          {%- endif -%}
        </div>
        <p style="color:#3F3F3D;font-size:13px;line-height:1.7;margin:0;">{{ section.settings.address }}</p>
      </div>
      <div style="background:#5B4373;border-radius:22px;padding:30px 32px;">
        <h3 style="font-family:'DM Serif Display',serif;font-weight:400;color:#FFFFFF;font-size:22px;margin:0 0 14px;">{{ section.settings.reach_heading }}</h3>
        <div style="display:flex;flex-direction:column;gap:8px;font-size:13px;color:#E8D8F8;">
          {%- if section.settings.email != blank -%}<a href="mailto:{{ section.settings.email }}" style="color:#E8D8F8;">{{ section.settings.email }}</a>{%- endif -%}
          {%- if section.settings.phone != blank -%}<a href="tel:{{ section.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}" style="color:#E8D8F8;">{{ section.settings.phone }}</a>{%- endif -%}
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .mb-booking { grid-template-columns: 1fr !important; gap: 24px !important; }
    #shopify-section-{{ section.id }} .mb-booking__row { grid-template-columns: 1fr !important; }
  }
</style>

{% schema %}
{
  "name": "Booking form",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Request an appointment" },
    { "type": "textarea", "id": "services", "label": "Service options (one per line)", "default": "Swedish massage — 60 min ($95)\nDeep tissue — 60 min ($110)\nAromatherapy massage — 75 min ($125)\nAromatherapy consultation — 30 min ($45)" },
    { "type": "text", "id": "submit_text", "label": "Submit button", "default": "Request booking" },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer", "default": "This is a request — I'll confirm by email." },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thanks! I'll confirm your appointment by email within one business day." },
    { "type": "header", "content": "Studio hours" },
    { "type": "text", "id": "hours_heading", "label": "Heading", "default": "Studio hours" },
    { "type": "textarea", "id": "hours", "label": "Hours (day | time per line)", "default": "Tue – Fri | 9am – 7pm\nSaturday | 10am – 4pm\nSun – Mon | Closed" },
    { "type": "header", "content": "Find the studio" },
    { "type": "text", "id": "find_heading", "label": "Heading", "default": "Find the studio" },
    { "type": "image_picker", "id": "map_image", "label": "Map image" },
    { "type": "richtext", "id": "address", "label": "Address", "default": "<p>128 Willow Lane, Studio 4<br>Portland, OR 97210</p>" },
    { "type": "header", "content": "Reach out" },
    { "type": "text", "id": "reach_heading", "label": "Heading", "default": "Prefer to reach out?" },
    { "type": "text", "id": "email", "label": "Email", "default": "hello@marlowebotanicals.co" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "(503) 555-0148" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FDF3EA" }
  ],
  "presets": [{ "name": "Booking form" }]
}
{% endschema %}
