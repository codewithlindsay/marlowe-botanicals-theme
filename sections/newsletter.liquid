{%- comment -%} Marlowe — newsletter signup (customer form) {%- endcomment -%}
<section data-section="newsletter" style="background:{{ section.settings.bg }};padding:84px 44px;position:relative;">
  <div style="position:absolute;top:20px;left:40px;pointer-events:none;">
    <svg width="52" height="52" viewBox="0 0 40 40" style="display:block;"><g fill="#FFFFFF"><circle cx="20" cy="12" r="6.6"></circle><circle cx="28" cy="20" r="6.6"></circle><circle cx="20" cy="28" r="6.6"></circle><circle cx="12" cy="20" r="6.6"></circle></g><circle cx="20" cy="20" r="4.2" fill="#A9CC7B"></circle></svg>
    <svg width="34" height="34" viewBox="0 0 40 40" style="display:block;margin:-6px 0 0 40px;"><g fill="#FFFFFF"><circle cx="20" cy="12" r="6.6"></circle><circle cx="28" cy="20" r="6.6"></circle><circle cx="20" cy="28" r="6.6"></circle><circle cx="12" cy="20" r="6.6"></circle></g><circle cx="20" cy="20" r="4.2" fill="#A9CC7B"></circle></svg>
  </div>
  <div style="max-width:760px;margin:0 auto;position:relative;background:#FFF9F0;border-radius:30px;padding:52px 56px;">
    <div class="mb-news__tag" style="position:absolute;top:-26px;right:-18px;width:118px;height:130px;border-radius:16px;transform:rotate(8deg);background:#A9CC7B;background-image:repeating-linear-gradient(-45deg,rgba(63,63,61,.1) 0 9px,transparent 9px 18px);display:flex;align-items:center;justify-content:center;">
      <span style="font-family:'Space Mono',monospace;font-size:10px;color:#3F3F3D;text-align:center;">{{ section.settings.tag_text }}</span>
    </div>
    <h2 style="font-family:'DM Serif Display',serif;font-style:italic;font-weight:400;color:#5B4373;font-size:40px;line-height:1.06;margin:0 0 16px;text-align:center;">{{ section.settings.heading }}</h2>
    <p style="color:#3F3F3D;font-size:13px;line-height:1.7;margin:0 auto 30px;text-align:center;max-width:440px;">{{ section.settings.subheading }}</p>
    {%- form 'customer', class: 'mb-news__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div style="display:flex;flex-direction:column;gap:14px;max-width:460px;margin:0 auto;">
        {%- if form.posted_successfully? -%}
          <p style="text-align:center;color:#5B4373;font-size:13px;">{{ section.settings.success_text }}</p>
        {%- endif -%}
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
          <input type="text" name="contact[first_name]" placeholder="First name" style="font-family:'Space Mono',monospace;font-size:13px;color:#3F3F3D;background:#FFFFFF;border:1.5px solid #C9B3E8;border-radius:10px;padding:14px 16px;width:100%;">
          <input type="text" name="contact[last_name]" placeholder="Last name" style="font-family:'Space Mono',monospace;font-size:13px;color:#3F3F3D;background:#FFFFFF;border:1.5px solid #C9B3E8;border-radius:10px;padding:14px 16px;width:100%;">
        </div>
        <input type="email" name="contact[email]" required placeholder="Email address" style="font-family:'Space Mono',monospace;font-size:13px;color:#3F3F3D;background:#FFFFFF;border:1.5px solid #C9B3E8;border-radius:10px;padding:14px 16px;width:100%;">
        <button type="submit" style="font-family:'Space Mono',monospace;font-size:13px;letter-spacing:.16em;text-transform:uppercase;color:#3F3F3D;background:#A9CC7B;border:none;border-radius:999px;padding:15px;cursor:pointer;margin-top:6px;">{{ section.settings.button_text }}</button>
      </div>
    {%- endform -%}
    <p style="color:#5B4373;font-size:10px;letter-spacing:.14em;text-transform:uppercase;text-align:center;margin:22px 0 0;">{{ section.settings.footnote }}</p>
  </div>
</section>

<style>
  @media screen and (max-width: 540px) {
    #shopify-section-{{ section.id }} .mb-news__tag { display: none !important; }
  }
</style>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Slow living, delivered weekly" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "A short, warm email every week — one blend to try, one small ritual, the occasional early peek at new oils. Zero pressure." },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Sign up" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thanks for subscribing!" },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "We respect your privacy." },
    { "type": "text", "id": "tag_text", "label": "Floating tag text", "default": "shopping bag" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#E8D8F8" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
