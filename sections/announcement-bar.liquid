{%- comment -%} Marlowe — announcement bar {%- endcomment -%}
<div data-section="announcement-bar" style="background:{{ section.settings.bg }};padding:9px 44px;text-align:center;">
  <span style="font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:{{ section.settings.text_color }};">{{ section.settings.text_1 }}&nbsp;&nbsp;<span style="color:{{ section.settings.accent }};">✦</span>&nbsp;&nbsp;{{ section.settings.text_2 }}</span>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "text_1", "label": "Message 1", "default": "Free shipping over $50" },
    { "type": "text", "id": "text_2", "label": "Message 2", "default": "Book a massage this month, take 10% off oils" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#5B4373" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FDF3EA" },
    { "type": "color", "id": "accent", "label": "Accent (star)", "default": "#A9CC7B" }
  ]
}
{% endschema %}
