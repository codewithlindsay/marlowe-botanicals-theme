{%- comment -%} Marlowe — scrolling text marquee (seamless at any width) {%- endcomment -%}
{%- assign parts = section.settings.text | split: '✦' -%}
{%- capture unit -%}{%- for p in parts -%}<span style="font-family:'DM Serif Display',serif;font-style:italic;font-size:27px;color:{{ section.settings.text_color }};">{{ p | strip }}</span>&nbsp;&nbsp;<span style="color:{{ section.settings.accent }};">✦</span>&nbsp;&nbsp;{%- endfor -%}{%- endcapture -%}
{%- assign dur = section.settings.speed | times: 4 -%}
<div data-section="marquee" style="background:{{ section.settings.bg }};padding:16px 0;overflow:hidden;">
  <div style="display:inline-block;white-space:nowrap;animation:mb-marquee-{{ section.id }} {{ dur }}s linear infinite;will-change:transform;">{%- for i in (1..8) -%}{{ unit }}{%- endfor -%}</div>
</div>
<style>
  @keyframes mb-marquee-{{ section.id }} { from { transform: translateX(0); } to { transform: translateX(-50%); } }
</style>

{% schema %}
{
  "name": "Marquee",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "text", "label": "Phrases (separate with ✦)", "default": "breathe deep ✦ rest often ✦ blended by hand ✦ botanicals only" },
    { "type": "range", "id": "speed", "min": 10, "max": 60, "step": 2, "unit": "s", "label": "Scroll duration", "default": 26 },
    { "type": "color", "id": "bg", "label": "Background", "default": "#5B4373" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#E8D8F8" },
    { "type": "color", "id": "accent", "label": "Star", "default": "#A9CC7B" }
  ],
  "presets": [{ "name": "Marquee" }]
}
{% endschema %}
