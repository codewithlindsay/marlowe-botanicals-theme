{%- comment -%} Marlowe — main product (gallery, variant pills, qty, add to cart, accordions) {%- endcomment -%}
{%- assign current = product.selected_or_first_available_variant -%}
<section data-section="product-info" class="mb-pdp" style="max-width:1180px;margin:0 auto;padding:32px 44px 80px;display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:start;">
  <div class="mb-pdp__media" style="position:sticky;top:24px;">
    <div style="border-radius:24px;overflow:hidden;aspect-ratio:1;background:#E8D8F8;display:flex;align-items:center;justify-content:center;background-image:repeating-linear-gradient(45deg,rgba(91,67,115,.07) 0 16px,transparent 16px 32px);">
      {%- if product.featured_media -%}
        <img id="mb-main-image" src="{{ product.featured_media | image_url: width: 1200 }}" alt="{{ product.title | escape }}" width="{{ product.featured_media.preview_image.width }}" height="{{ product.featured_media.preview_image.height }}" style="width:100%;height:100%;object-fit:cover;">
      {%- else -%}
        <span style="font-family:'Space Mono',monospace;font-size:13px;color:#5B4373;text-align:center;">main product shot<br>— {{ product.title | default: 'Lavender Calm Oil' }}</span>
      {%- endif -%}
    </div>
    {%- if product.media.size > 1 -%}
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:14px;">
        {%- for media in product.media limit: 3 -%}
          <button type="button" class="mb-thumb" data-full="{{ media | image_url: width: 1200 }}" style="border:none;padding:0;border-radius:14px;aspect-ratio:1;overflow:hidden;cursor:pointer;background:#D8C4F0;">
            <img src="{{ media | image_url: width: 300 }}" alt="" width="{{ media.preview_image.width }}" height="{{ media.preview_image.height }}" style="width:100%;height:100%;object-fit:cover;">
          </button>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:14px;">
        <div style="border-radius:14px;aspect-ratio:1;background:#D8C4F0;display:flex;align-items:center;justify-content:center;background-image:repeating-linear-gradient(45deg,rgba(91,67,115,.07) 0 12px,transparent 12px 24px);"><span style="font-family:'Space Mono',monospace;font-size:10px;color:#5B4373;">detail</span></div>
        <div style="border-radius:14px;aspect-ratio:1;background:#E4EFD1;display:flex;align-items:center;justify-content:center;background-image:repeating-linear-gradient(45deg,rgba(91,67,115,.07) 0 12px,transparent 12px 24px);"><span style="font-family:'Space Mono',monospace;font-size:10px;color:#5B4373;">texture</span></div>
        <div style="border-radius:14px;aspect-ratio:1;background:#D9E8C0;display:flex;align-items:center;justify-content:center;background-image:repeating-linear-gradient(45deg,rgba(91,67,115,.07) 0 12px,transparent 12px 24px);"><span style="font-family:'Space Mono',monospace;font-size:10px;color:#5B4373;">in&nbsp;use</span></div>
      </div>
    {%- endif -%}
  </div>

  <div>
    {%- if section.settings.eyebrow != blank or product.type != blank -%}
      <p style="font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:#A9CC7B;margin:0 0 12px;">{{ section.settings.eyebrow | default: product.type }}</p>
    {%- endif -%}
    <h1 style="font-family:'DM Serif Display',serif;font-weight:400;color:#5B4373;font-size:48px;line-height:1;margin:0 0 14px;">{{ product.title | default: 'Lavender Calm Oil' }}</h1>
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;">
      <span style="color:#5B4373;font-size:15px;letter-spacing:.14em;">★★★★★</span>
      <span style="color:#3F3F3D;font-size:12px;">{{ section.settings.review_count }}</span>
    </div>
    <div id="mb-price" style="font-family:'DM Serif Display',serif;color:#5B4373;font-size:34px;margin-bottom:22px;">{{ current.price | money }}</div>
    <div style="color:#3F3F3D;font-size:14px;line-height:1.75;margin:0 0 30px;max-width:440px;">
      {%- if product.description != blank -%}{{ product.description }}{%- else -%}A single-note lavender oil distilled from organically grown buds. Calming, floral, and clean — a few drops to ease into sleep or soften a tense evening.{%- endif -%}
    </div>

    {%- form 'product', product, id: 'mb-product-form' -%}
      {%- unless product.has_only_default_variant -%}
        <p style="font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#5B4373;margin:0 0 10px;">{{ product.options.first | default: 'Size' }}</p>
        <div class="mb-sizes" style="display:flex;gap:12px;margin-bottom:26px;flex-wrap:wrap;">
          {%- for variant in product.variants -%}
            <button type="button" class="mb-size{% if variant.id == current.id %} is-selected{% endif %}" data-id="{{ variant.id }}" data-price="{{ variant.price | money }}" {% unless variant.available %}data-unavailable="true"{% endunless %} style="text-align:center;padding:13px 18px;border-radius:10px;font-family:'Space Mono',monospace;font-size:12px;letter-spacing:.04em;cursor:pointer;transition:all .15s;">{{ variant.title }}</button>
          {%- endfor -%}
        </div>
      {%- endunless -%}
      <input type="hidden" name="id" id="mb-variant-id" value="{{ current.id }}">

      <p style="font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#5B4373;margin:0 0 10px;">Quantity</p>
      <div style="display:flex;align-items:center;gap:0;border:2px solid #D8C4F0;border-radius:999px;width:fit-content;margin-bottom:26px;overflow:hidden;">
        <button type="button" id="mb-qty-dec" aria-label="Decrease" style="background:none;border:none;color:#5B4373;font-size:18px;width:44px;height:44px;cursor:pointer;">−</button>
        <input type="number" name="quantity" id="mb-qty" value="1" min="1" style="width:44px;text-align:center;color:#5B4373;font-size:15px;font-weight:700;border:none;background:none;-moz-appearance:textfield;">
        <button type="button" id="mb-qty-inc" aria-label="Increase" style="background:none;border:none;color:#5B4373;font-size:18px;width:44px;height:44px;cursor:pointer;">+</button>
      </div>

      <div style="display:flex;flex-direction:column;gap:12px;max-width:440px;margin-bottom:26px;">
        <button type="submit" name="add" {% unless current.available %}disabled{% endunless %} style="background:#5B4373;color:#FDF3EA;border:none;font-size:13px;letter-spacing:.16em;text-transform:uppercase;padding:17px;border-radius:999px;cursor:pointer;">
          <span id="mb-atc-label">{% if current.available %}Add to cart · {{ current.price | money }}{% else %}Sold out{% endif %}</span>
        </button>
        {{ form | payment_button }}
      </div>
    {%- endform -%}

    <div style="display:flex;gap:22px;flex-wrap:wrap;margin-bottom:30px;font-family:'Space Mono',monospace;font-size:11px;color:#3F3F3D;">
      <span><span style="color:#A9CC7B;">✦</span> Free shipping over $50</span>
      <span><span style="color:#A9CC7B;">✦</span> Cruelty-free</span>
      <span><span style="color:#A9CC7B;">✦</span> Small-batch</span>
    </div>

    <div style="max-width:460px;border-top:1px solid rgba(91,67,115,.2);">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }} {% if forloop.first %}open{% endif %} style="border-bottom:1px solid rgba(91,67,115,.2);">
          <summary class="mb-acc" style="list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;padding:18px 2px;font-family:'Space Mono',monospace;font-size:13px;font-weight:700;color:#5B4373;">{{ block.settings.heading }}<span class="mb-acc-chev" style="color:#A9CC7B;transition:transform .25s;">▼</span></summary>
          <div style="color:#3F3F3D;font-size:13px;line-height:1.7;margin:0;padding:0 2px 18px;">
            {%- if block.settings.use_product_description and product.description != blank -%}{{ product.description }}{%- else -%}{{ block.settings.content }}{%- endif -%}
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .mb-size { border: 2px solid #D8C4F0; background: #FFFFFF; color: #5B4373; }
  #shopify-section-{{ section.id }} .mb-size.is-selected { border: 2px solid #5B4373; background: #E8D8F8; color: #5B4373; }
  #shopify-section-{{ section.id }} .mb-size[data-unavailable] { opacity: .4; text-decoration: line-through; cursor: not-allowed; }
  #shopify-section-{{ section.id }} summary.mb-acc::-webkit-details-marker { display: none; }
  #shopify-section-{{ section.id }} details[open] > summary.mb-acc .mb-acc-chev { transform: rotate(180deg); }
  #shopify-section-{{ section.id }} #mb-qty::-webkit-outer-spin-button,
  #shopify-section-{{ section.id }} #mb-qty::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .mb-pdp { grid-template-columns: 1fr !important; gap: 32px !important; }
    #shopify-section-{{ section.id }} .mb-pdp__media { position: static !important; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var idInput = root.querySelector('#mb-variant-id');
    var priceEl = root.querySelector('#mb-price');
    var atcLabel = root.querySelector('#mb-atc-label');
    root.querySelectorAll('.mb-size').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (btn.hasAttribute('data-unavailable')) return;
        root.querySelectorAll('.mb-size').forEach(function (b) { b.classList.remove('is-selected'); });
        btn.classList.add('is-selected');
        if (idInput) idInput.value = btn.getAttribute('data-id');
        var p = btn.getAttribute('data-price');
        if (priceEl) priceEl.textContent = p;
        if (atcLabel) atcLabel.textContent = 'Add to cart · ' + p;
      });
    });
    var qty = root.querySelector('#mb-qty');
    var dec = root.querySelector('#mb-qty-dec');
    var inc = root.querySelector('#mb-qty-inc');
    if (dec) dec.addEventListener('click', function () { qty.value = Math.max(1, (parseInt(qty.value, 10) || 1) - 1); });
    if (inc) inc.addEventListener('click', function () { qty.value = (parseInt(qty.value, 10) || 1) + 1; });
    root.querySelectorAll('.mb-thumb').forEach(function (t) {
      t.addEventListener('click', function () {
        var main = root.querySelector('#mb-main-image');
        if (main) main.src = t.getAttribute('data-full');
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Product info",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (defaults to product type)", "default": "Bestseller · Aromatherapy" },
    { "type": "text", "id": "review_count", "label": "Review count text", "default": "128 reviews" }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Description" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Details go here.</p>" },
        { "type": "checkbox", "id": "use_product_description", "label": "Use product description instead", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product info",
      "blocks": [
        { "type": "accordion", "settings": { "heading": "Description", "use_product_description": true, "content": "<p>Distilled from organically grown Lavandula angustifolia. Floral, herbaceous, and calming — ideal for winding down before sleep.</p>" } },
        { "type": "accordion", "settings": { "heading": "How to use", "content": "<p>Add 4–6 drops to a diffuser, or dilute with a carrier oil for a pulse-point roll-on. Never apply undiluted to skin.</p>" } },
        { "type": "accordion", "settings": { "heading": "Ingredients", "content": "<p>100% Lavandula angustifolia (lavender) essential oil. Nothing else.</p>" } },
        { "type": "accordion", "settings": { "heading": "Shipping & returns", "content": "<p>Free shipping over $50. Ships in 1–2 business days. Unopened bottles returnable within 30 days.</p>" } }
      ]
    }
  ]
}
{% endschema %}
