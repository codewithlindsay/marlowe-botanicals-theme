{%- comment -%} Marlowe — header (logo, nav from menu, book CTA, cart) {%- endcomment -%}
<header data-section="header" class="mb-header" style="background:{{ section.settings.bg }};padding:20px 44px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;">
  <a href="{{ routes.root_url }}" style="font-family:'DM Serif Display',serif;font-size:36px;line-height:1;color:{{ section.settings.text_color }};">
    {%- if section.settings.logo != blank -%}
      <img src="{{ section.settings.logo | image_url: width: 320 }}" alt="{{ shop.name | escape }}" width="{{ section.settings.logo.width }}" height="{{ section.settings.logo.height }}" style="max-height:44px;width:auto;display:block;">
    {%- else -%}
      {{ section.settings.logo_text | default: shop.name }}
    {%- endif -%}
  </a>
  <nav class="mb-nav" style="display:flex;align-items:center;gap:30px;font-family:'Space Mono',monospace;font-size:16px;letter-spacing:.16em;text-transform:uppercase;">
    {%- for link in section.settings.menu.links -%}
      <a href="{{ link.url }}" style="color:{{ section.settings.text_color }};">{{ link.title }}</a>
    {%- endfor -%}
    {%- if section.settings.cta_text != blank -%}
      <a href="{{ section.settings.cta_link | default: '#' }}" style="color:{{ section.settings.text_color }};background:{{ section.settings.cta_bg }};border:2px solid {{ section.settings.text_color }};border-radius:999px;padding:11px 22px;">{{ section.settings.cta_text }}</a>
    {%- endif -%}
    <a href="{{ routes.cart_url }}" data-mb-cart-open aria-label="Cart" style="position:relative;display:flex;align-items:center;color:{{ section.settings.text_color }};">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="{{ section.settings.text_color }}" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8h12l-1 12H7L6 8z"></path><path d="M9 8a3 3 0 0 1 6 0"></path></svg>
      <span class="mb-cart-count" style="position:absolute;top:-7px;right:-9px;background:{{ section.settings.accent }};color:#3F3F3D;font-size:12px;font-weight:700;min-width:17px;height:17px;border-radius:999px;display:flex;align-items:center;justify-content:center;padding:0 4px;">{{ cart.item_count }}</span>
    </a>
  </nav>
</header>

<style>
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .mb-header { padding: 16px 20px !important; }
    #shopify-section-{{ section.id }} .mb-nav { gap: 16px !important; font-size:13px !important; width: 100%; justify-content: flex-start; flex-wrap: wrap; }
  }
</style>

{% schema %}
{
  "name": "Header",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo image (optional)" },
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "Marlowe" },
    { "type": "link_list", "id": "menu", "label": "Navigation menu", "default": "main-menu" },
    { "type": "text", "id": "cta_text", "label": "CTA button text", "default": "Book a session" },
    { "type": "url", "id": "cta_link", "label": "CTA button link" },
    { "type": "color", "id": "cta_bg", "label": "CTA button background", "default": "#FDF3EA" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#E8D8F8" },
    { "type": "color", "id": "text_color", "label": "Text / links", "default": "#5B4373" },
    { "type": "color", "id": "accent", "label": "Cart badge", "default": "#A9CC7B" }
  ]
}
{% endschema %}
