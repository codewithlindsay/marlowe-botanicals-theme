{%- comment -%} Marlowe — CTA (newsletter-style card, tile bottom-left) {%- endcomment -%}
<section data-section="cta" style="background:{{ section.settings.bg }};padding:84px 44px;position:relative;">
  <div style="position:absolute;top:20px;left:40px;pointer-events:none;">
    <svg width="52" height="52" viewBox="0 0 40 40" style="display:block;"><g fill="#FFFFFF"><circle cx="20" cy="12" r="6.6"></circle><circle cx="28" cy="20" r="6.6"></circle><circle cx="20" cy="28" r="6.6"></circle><circle cx="12" cy="20" r="6.6"></circle></g><circle cx="20" cy="20" r="4.2" fill="#A9CC7B"></circle></svg>
    <svg width="34" height="34" viewBox="0 0 40 40" style="display:block;margin:-6px 0 0 40px;"><g fill="#FFFFFF"><circle cx="20" cy="12" r="6.6"></circle><circle cx="28" cy="20" r="6.6"></circle><circle cx="20" cy="28" r="6.6"></circle><circle cx="12" cy="20" r="6.6"></circle></g><circle cx="20" cy="20" r="4.2" fill="#A9CC7B"></circle></svg>
  </div>
  <div style="max-width:760px;margin:0 auto;position:relative;background:#FFF9F0;border-radius:30px;padding:56px 56px;">
    <div class="mb-cta__tile" style="position:absolute;bottom:-26px;left:-18px;width:{{ section.settings.tile_size }}px;aspect-ratio:118/130;border-radius:16px;transform:rotate(-8deg);overflow:hidden;background:#A9CC7B;background-image:repeating-linear-gradient(-45deg,rgba(63,63,61,.1) 0 9px,transparent 9px 18px);display:flex;align-items:center;justify-content:center;">
      {%- if section.settings.tile_image != blank -%}
        <img src="{{ section.settings.tile_image | image_url: width: 400 }}" alt="{{ section.settings.tile_image.alt | escape }}" loading="lazy" width="{{ section.settings.tile_image.width }}" height="{{ section.settings.tile_image.height }}" style="width:100%;height:100%;object-fit:cover;">
      {%- else -%}
        <span style="font-family:'Space Mono',monospace;font-size:10px;color:#3F3F3D;text-align:center;">{{ section.settings.tile_text }}</span>
      {%- endif -%}
    </div>
    <h2 style="font-family:'DM Serif Display',serif;font-style:italic;font-weight:400;color:#5B4373;font-size:40px;line-height:1.06;margin:0 0 8px;text-align:center;">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p style="color:#3F3F3D;font-size:13px;line-height:1.7;margin:0 auto 8px;text-align:center;max-width:440px;">{{ section.settings.subheading }}</p>
    {%- endif -%}
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-top:26px;">
      {%- if section.settings.button_1_text != blank -%}<a href="{{ section.settings.button_1_link | default: '#' }}" style="display:inline-block;background:#5B4373;color:#FDF3EA;font-size:13px;letter-spacing:.16em;text-transform:uppercase;padding:16px 30px;border-radius:999px;">{{ section.settings.button_1_text }}</a>{%- endif -%}
      {%- if section.settings.button_2_text != blank -%}<a href="{{ section.settings.button_2_link | default: '#' }}" style="display:inline-block;border:2px solid #5B4373;color:#5B4373;font-size:13px;letter-spacing:.16em;text-transform:uppercase;padding:15px 28px;border-radius:999px;">{{ section.settings.button_2_text }}</a>{%- endif -%}
    </div>
  </div>
</section>

<style>
  @media screen and (max-width: 540px) {
    #shopify-section-{{ section.id }} .mb-cta__tile { display: none !important; }
  }
</style>

{% schema %}
{
  "name": "CTA",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready to slow down?" },
    { "type": "textarea", "id": "subheading", "label": "Subheading (optional)", "default": "" },
    { "type": "text", "id": "button_1_text", "label": "Button 1 text", "default": "Shop now" },
    { "type": "url", "id": "button_1_link", "label": "Button 1 link" },
    { "type": "text", "id": "button_2_text", "label": "Button 2 text", "default": "Book a session" },
    { "type": "url", "id": "button_2_link", "label": "Button 2 link" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#E8D8F8" },
    { "type": "header", "content": "Floating tile (bottom left)" },
    { "type": "image_picker", "id": "tile_image", "label": "Tile image", "info": "Optional. Falls back to the striped placeholder + text below when empty." },
    { "type": "range", "id": "tile_size", "min": 70, "max": 240, "step": 2, "unit": "px", "label": "Tile width", "default": 118 },
    { "type": "text", "id": "tile_text", "label": "Tile placeholder text", "default": "oils on the bench" }
  ],
  "presets": [{ "name": "CTA" }]
}
{% endschema %}
