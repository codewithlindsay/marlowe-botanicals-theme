{%- comment -%} Marlowe — services (multicolumn: intro / button stack / image) {%- endcomment -%}
<section data-section="services" style="background:{{ section.settings.bg }};padding:80px 44px;">
  <div class="mb-services" style="max-width:1180px;margin:0 auto;display:grid;grid-template-columns:.72fr 1fr .78fr;gap:44px;align-items:center;">
    <div>
      <h2 style="font-family:'DM Serif Display',serif;font-style:italic;font-weight:400;color:#5B4373;font-size:49px;line-height:1.05;margin:0 0 20px;">{{ section.settings.heading }}</h2>
      <p style="color:#3F3F3D;font-size:16px;line-height:1.75;margin:0;max-width:280px;">{{ section.settings.intro }}</p>
    </div>
    <div style="display:flex;flex-direction:column;gap:16px;">
      {%- for block in section.blocks -%}
        <a {{ block.shopify_attributes }} href="{{ block.settings.link | default: '#' }}" style="display:block;text-align:center;background:{{ block.settings.bg }};color:{{ block.settings.text_color }};font-family:'DM Serif Display',serif;font-style:italic;font-size:31px;padding:20px;border-radius:16px;">{{ block.settings.label }}</a>
      {%- endfor -%}
    </div>
    <div style="position:relative;">
      <div style="border-radius:26px;overflow:hidden;aspect-ratio:.82;background:#E4EFD1;display:flex;align-items:center;justify-content:center;background-image:repeating-linear-gradient(45deg,rgba(91,67,115,.07) 0 14px,transparent 14px 28px);">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" style="width:100%;height:100%;object-fit:cover;">
        {%- else -%}
          <span style="font-family:'Space Mono',monospace;font-size:15px;color:#5B4373;text-align:center;">Massage in session</span>
        {%- endif -%}
      </div>
      <div class="mb-services__tag" style="position:absolute;bottom:-20px;left:-22px;width:{{ section.settings.tag_size }}px;aspect-ratio:96/112;border-radius:16px;transform:rotate(-10deg);background:#5B4373;background-image:repeating-linear-gradient(-45deg,rgba(224,203,245,.16) 0 9px,transparent 9px 18px);display:flex;align-items:center;justify-content:center;overflow:hidden;">
        {%- if section.settings.tag_image != blank -%}
          <img src="{{ section.settings.tag_image | image_url: width: 400 }}" alt="{{ section.settings.tag_image.alt | escape }}" loading="lazy" width="{{ section.settings.tag_image.width }}" height="{{ section.settings.tag_image.height }}" style="width:100%;height:100%;object-fit:cover;">
        {%- else -%}
          <span style="font-family:'Space Mono',monospace;font-size:12px;color:#E8D8F8;text-align:center;">{{ section.settings.tag_text }}</span>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  @media screen and (max-width: 900px) {
    #shopify-section-{{ section.id }} .mb-services { grid-template-columns: 1fr !important; gap: 36px !important; }
    #shopify-section-{{ section.id }} .mb-services__tag { left: 8px !important; }
  }
</style>

{% schema %}
{
  "name": "Services",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose your calm" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Come in for hands-on bodywork, build a custom blend with me, or take the ritual home. There's a way in whatever you're after." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "header", "content": "Floating tile (overlaps the image)" },
    { "type": "image_picker", "id": "tag_image", "label": "Tile image", "info": "Optional. Falls back to the striped placeholder + text below when empty." },
    { "type": "range", "id": "tag_size", "min": 60, "max": 200, "step": 2, "unit": "px", "label": "Tile width", "default": 96 },
    { "type": "text", "id": "tag_text", "label": "Tile placeholder text", "default": "oil bottle" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#E8D8F8" }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service button",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Service name" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "color", "id": "bg", "label": "Background", "default": "#E8D8F8" },
        { "type": "color", "id": "text_color", "label": "Text", "default": "#5B4373" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Services",
      "blocks": [
        { "type": "service", "settings": { "label": "Swedish Massage", "bg": "#E8D8F8", "text_color": "#5B4373" } },
        { "type": "service", "settings": { "label": "Aromatherapy Consult", "bg": "#A9CC7B", "text_color": "#3F3F3D" } },
        { "type": "service", "settings": { "label": "Gift Cards", "bg": "#E4EFD1", "text_color": "#5B4373" } },
        { "type": "service", "settings": { "label": "Shop the Oils", "bg": "#5B4373", "text_color": "#E4EFD1" } }
      ]
    }
  ]
}
{% endschema %}
