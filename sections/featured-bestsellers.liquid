{%- comment -%} Marlowe — featured bestsellers (product card grid via blocks) {%- endcomment -%}
<section data-section="featured-bestsellers" style="background:{{ section.settings.bg }};padding:8px 44px 94px;position:relative;">
  <div style="max-width:1180px;margin:0 auto;">
    <div style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:16px;margin-bottom:32px;">
      <h2 style="font-family:'DM Serif Display',serif;font-style:italic;font-weight:400;color:#5B4373;font-size:49px;line-height:1;margin:0;">{{ section.settings.heading }}</h2>
      <div style="display:flex;align-items:center;gap:0;">
        <svg width="34" height="34" viewBox="0 0 40 40" style="display:block;margin:-6px 34px 0 0;"><g fill="#FFFFFF"><circle cx="20" cy="12" r="6.6"></circle><circle cx="28" cy="20" r="6.6"></circle><circle cx="20" cy="28" r="6.6"></circle><circle cx="12" cy="20" r="6.6"></circle></g><circle cx="20" cy="20" r="4.2" fill="#A9CC7B"></circle></svg>
        {%- if section.settings.link_text != blank -%}<a href="{{ section.settings.link_url | default: section.settings.collection.url | default: routes.all_products_collection_url }}" style="color:#5B4373;font-size:15px;letter-spacing:.16em;text-transform:uppercase;border-bottom:2px solid #5B4373;padding-bottom:3px;">{{ section.settings.link_text }}</a>{%- endif -%}
      </div>
    </div>
    {%- assign coll = section.settings.collection -%}
    {%- if coll != blank and coll.products.size > 0 -%}
      <div class="mb-cards mb-cards--4" style="display:grid;grid-template-columns:repeat(4,1fr);gap:22px;">
        {%- for product in coll.products limit: section.settings.products_to_show -%}
          {%- assign v = product.selected_or_first_available_variant -%}
          <div style="background:#FFFFFF;border-radius:20px;padding:16px 16px 22px;display:flex;flex-direction:column;">
            <a href="{{ product.url }}" style="border-radius:14px;aspect-ratio:.86;background:{% cycle 'bs': '#E4EFD1','#D9E8C0','#D8C4F0','#E4EFD1' %};display:flex;align-items:center;justify-content:center;background-image:repeating-linear-gradient(45deg,rgba(91,67,115,.07) 0 12px,transparent 12px 24px);margin-bottom:16px;position:relative;overflow:hidden;">
              {%- if product.featured_image -%}
                <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;">
              {%- endif -%}
              {%- if product.compare_at_price > product.price -%}
                <span style="position:absolute;top:12px;left:12px;background:#A9CC7B;color:#3F3F3D;font-size:10px;letter-spacing:.12em;text-transform:uppercase;padding:5px 10px;border-radius:999px;">Sale</span>
              {%- endif -%}
            </a>
            <a href="{{ product.url }}" style="color:#5B4373;"><h3 style="font-family:'DM Serif Display',serif;font-weight:400;color:#5B4373;font-size:25px;margin:0 0 6px;">{{ product.title }}</h3></a>
            <p style="color:#3F3F3D;font-size:15px;line-height:1.55;margin:0 0 16px;flex:1;">{{ product.description | strip_html | truncatewords: 12 }}</p>
            <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;">
              <span style="color:#5B4373;font-family:'Space Mono',monospace;font-weight:700;font-size:18px;">{{ product.price | money }}</span>
              {%- if product.has_only_default_variant and v.available -%}
                {%- form 'product', product -%}
                  <input type="hidden" name="id" value="{{ v.id }}">
                  <button type="submit" name="add" style="background:#5B4373;color:#FDF3EA;border:none;cursor:pointer;font-family:'Space Mono',monospace;font-size:12px;letter-spacing:.14em;text-transform:uppercase;padding:10px 16px;border-radius:999px;">{{ section.settings.button_label }}</button>
                {%- endform -%}
              {%- else -%}
                <a href="{{ product.url }}" style="background:#5B4373;color:#FDF3EA;font-size:12px;letter-spacing:.14em;text-transform:uppercase;padding:10px 16px;border-radius:999px;">{% if v.available %}{{ section.settings.button_label }}{% else %}Sold out{% endif %}</a>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="mb-cards mb-cards--4" style="display:grid;grid-template-columns:repeat(4,1fr);gap:22px;">
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }} style="background:#FFFFFF;border-radius:20px;padding:16px 16px 22px;display:flex;flex-direction:column;">
            <div style="border-radius:14px;aspect-ratio:.86;background:{{ block.settings.image_bg }};display:flex;align-items:center;justify-content:center;background-image:repeating-linear-gradient(45deg,rgba(91,67,115,.07) 0 12px,transparent 12px 24px);margin-bottom:16px;position:relative;overflow:hidden;">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;">
              {%- endif -%}
              {%- if block.settings.badge != blank -%}
                <span style="position:absolute;top:12px;left:12px;background:{{ block.settings.badge_bg }};color:{{ block.settings.badge_color }};font-size:10px;letter-spacing:.12em;text-transform:uppercase;padding:5px 10px;border-radius:999px;">{{ block.settings.badge }}</span>
              {%- endif -%}
            </div>
            <h3 style="font-family:'DM Serif Display',serif;font-weight:400;color:#5B4373;font-size:25px;margin:0 0 6px;">{{ block.settings.title }}</h3>
            <p style="color:#3F3F3D;font-size:15px;line-height:1.55;margin:0 0 16px;flex:1;">{{ block.settings.description }}</p>
            <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;">
              <span style="color:#5B4373;font-family:'Space Mono',monospace;font-weight:700;font-size:18px;">{{ block.settings.price }}</span>
              <a href="{{ block.settings.link | default: '#' }}" style="background:#5B4373;color:#FDF3EA;font-size:12px;letter-spacing:.14em;text-transform:uppercase;padding:10px 16px;border-radius:999px;">{{ section.settings.button_label }}</a>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
{%- if section.settings.show_wave -%}
<div style="background:{{ section.settings.bg }};line-height:0;">
  <svg viewBox="0 0 1440 60" preserveAspectRatio="none" style="display:block;width:100%;height:52px;"><path fill="{{ section.settings.wave_color }}" d="M0,60 L0,30 Q60,0 120,30 T240,30 T360,30 T480,30 T600,30 T720,30 T840,30 T960,30 T1080,30 T1200,30 T1320,30 T1440,30 L1440,60 Z"></path></svg>
</div>
{%- endif -%}

<style>
  @media screen and (max-width: 989px) { #shopify-section-{{ section.id }} .mb-cards--4 { grid-template-columns: repeat(2, 1fr) !important; } }
  @media screen and (max-width: 540px) { #shopify-section-{{ section.id }} .mb-cards--4 { grid-template-columns: 1fr !important; } }
</style>

{% schema %}
{
  "name": "Bestsellers grid",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the bestsellers" },
    { "type": "text", "id": "link_text", "label": "Link text", "default": "View all products" },
    { "type": "url", "id": "link_url", "label": "Link URL" },
    { "type": "text", "id": "button_label", "label": "Card button label", "default": "Add to cart" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Pick a collection to show real products. Leave empty to use the hand-built cards below." },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 1, "label": "Products to show", "default": 4 },
    { "type": "color", "id": "bg", "label": "Background", "default": "#E8D8F8" },
    { "type": "header", "content": "Bottom wave" },
    { "type": "checkbox", "id": "show_wave", "label": "Show bottom wave", "default": true },
    { "type": "color", "id": "wave_color", "label": "Wave color (next section bg)", "default": "#FDF3EA" }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "color", "id": "image_bg", "label": "Image placeholder color", "default": "#E4EFD1" },
        { "type": "text", "id": "badge", "label": "Badge" },
        { "type": "color", "id": "badge_bg", "label": "Badge background", "default": "#A9CC7B" },
        { "type": "color", "id": "badge_color", "label": "Badge text", "default": "#3F3F3D" },
        { "type": "text", "id": "title", "label": "Title", "default": "Product name" },
        { "type": "text", "id": "description", "label": "Description", "default": "Short product description." },
        { "type": "text", "id": "price", "label": "Price", "default": "$24" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bestsellers grid",
      "blocks": [
        { "type": "product_card", "settings": { "image_bg": "#E4EFD1", "badge": "Bestseller", "badge_bg": "#A9CC7B", "badge_color": "#3F3F3D", "title": "Lavender Calm Oil", "description": "Pure lavender to unwind before sleep.", "price": "$24" } },
        { "type": "product_card", "settings": { "image_bg": "#D9E8C0", "badge": "New", "badge_bg": "#5B4373", "badge_color": "#E4EFD1", "title": "Muscle Melt Massage Oil", "description": "Warming blend for tired, knotted muscles.", "price": "$32" } },
        { "type": "product_card", "settings": { "image_bg": "#D8C4F0", "title": "Eucalyptus Breathe Roll-On", "description": "Clear the head and open the chest, on the go.", "price": "$18" } },
        { "type": "product_card", "settings": { "image_bg": "#E4EFD1", "title": "Sweet Almond Carrier Oil", "description": "Silky, unscented base for your own blends.", "price": "$16" } }
      ]
    }
  ]
}
{% endschema %}
