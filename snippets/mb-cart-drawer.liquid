{%- comment -%} Marlowe — AJAX cart drawer (works with the theme's custom add-to-cart forms) {%- endcomment -%}
<div id="mb-cart" class="mb-cart" aria-hidden="true">
  <div class="mb-cart__overlay" data-mb-cart-close></div>
  <aside class="mb-cart__panel" role="dialog" aria-modal="true" aria-label="Cart">
    <div class="mb-cart__head">
      <span class="mb-cart__title">Your cart</span>
      <button type="button" class="mb-cart__x" data-mb-cart-close aria-label="Close cart">&times;</button>
    </div>
    {% render 'free-shipping-bar',
      threshold: settings.fsb_drawer_threshold,
      progress_message: settings.fsb_progress_message,
      success_message: settings.fsb_success_message,
      bg_color: settings.fsb_drawer_bg_color,
      text_color: settings.fsb_drawer_text_color,
      fill_color: settings.fsb_drawer_fill_color,
      fill_color_near: settings.fsb_drawer_fill_near,
      switch_percent: settings.fsb_switch_percent,
      font_size: settings.fsb_drawer_font_size,
      bar_height: settings.fsb_drawer_bar_height,
      bar_max_width: settings.fsb_drawer_bar_max_width
    %}
    <div id="mb-cart-items" class="mb-cart__items"></div>
    <p id="mb-cart-empty" class="mb-cart__empty" hidden>Your cart is empty.</p>
    <div id="mb-cart-foot" class="mb-cart__foot" hidden>
      <div class="mb-cart__subtotal"><span>Subtotal</span><span id="mb-cart-subtotal"></span></div>
      <p class="mb-cart__note">Taxes and shipping calculated at checkout.</p>
      <form action="{{ routes.cart_url }}" method="post">
        <button type="submit" name="checkout" class="mb-cart__checkout">Checkout</button>
      </form>
      <a href="{{ routes.cart_url }}" class="mb-cart__viewcart">View cart</a>
    </div>
  </aside>
</div>

<style>
  .mb-cart { position: fixed; inset: 0; z-index: 100000; visibility: hidden; }
  .mb-cart.is-open { visibility: visible; }
  .mb-cart__overlay { position: absolute; inset: 0; background: rgba(63,63,61,.5); opacity: 0; transition: opacity .3s ease; }
  .mb-cart.is-open .mb-cart__overlay { opacity: 1; }
  .mb-cart__panel { position: absolute; top: 0; right: 0; height: 100%; width: min(410px, 92vw); background: #FDF3EA; display: flex; flex-direction: column; transform: translateX(100%); transition: transform .32s cubic-bezier(.4,0,.2,1); box-shadow: -8px 0 40px rgba(63,63,61,.18); }
  .mb-cart.is-open .mb-cart__panel { transform: translateX(0); }
  .mb-cart__head { display: flex; align-items: center; justify-content: space-between; padding: 22px 24px; border-bottom: 1px solid rgba(91,67,115,.18); }
  .mb-cart__title { font-family: 'DM Serif Display', serif; font-style: italic; font-size: 26px; color: #5B4373; }
  .mb-cart__x { background: none; border: none; font-size: 30px; line-height: 1; color: #5B4373; cursor: pointer; padding: 0 4px; }
  .mb-cart__items { flex: 1; overflow-y: auto; padding: 8px 24px; }
  .mb-cart__empty { flex: 1; display: flex; align-items: center; justify-content: center; font-family: 'Space Mono', monospace; font-size: 14px; color: #3F3F3D; }
  .mb-cart__empty[hidden] { display: none; }
  .mb-ci { display: grid; grid-template-columns: 68px 1fr; gap: 14px; padding: 18px 0; border-bottom: 1px solid rgba(91,67,115,.14); }
  .mb-ci__img { width: 68px; height: 78px; object-fit: cover; border-radius: 10px; background: #E8D8F8; }
  .mb-ci__img--ph { background-image: repeating-linear-gradient(45deg, rgba(91,67,115,.1) 0 10px, transparent 10px 20px); }
  .mb-ci__title { font-family: 'DM Serif Display', serif; font-size: 18px; color: #5B4373; text-decoration: none; display: block; margin-bottom: 2px; }
  .mb-ci__variant { font-family: 'Space Mono', monospace; font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: #3F3F3D; margin-bottom: 8px; }
  .mb-ci__row { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 6px; }
  .mb-ci__qty { display: inline-flex; align-items: center; border: 1.5px solid #D8C4F0; border-radius: 999px; overflow: hidden; }
  .mb-ci__qty button { background: none; border: none; width: 30px; height: 30px; font-size: 16px; color: #5B4373; cursor: pointer; }
  .mb-ci__q { min-width: 26px; text-align: center; font-family: 'Space Mono', monospace; font-size: 13px; font-weight: 700; color: #5B4373; }
  .mb-ci__price { font-family: 'Space Mono', monospace; font-weight: 700; font-size: 14px; color: #5B4373; }
  .mb-ci__remove { background: none; border: none; padding: 0; margin-top: 8px; font-family: 'Space Mono', monospace; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: #8a7ba0; cursor: pointer; text-decoration: underline; }
  .mb-cart__foot { padding: 20px 24px 24px; border-top: 1px solid rgba(91,67,115,.18); }
  .mb-cart__subtotal { display: flex; justify-content: space-between; font-family: 'Space Mono', monospace; font-weight: 700; font-size: 16px; color: #5B4373; text-transform: uppercase; letter-spacing: .06em; }
  .mb-cart__note { font-family: 'Space Mono', monospace; font-size: 11px; color: #3F3F3D; margin: 8px 0 16px; }
  .mb-cart__checkout { display: block; width: 100%; background: #5B4373; color: #FDF3EA; border: none; font-family: 'Space Mono', monospace; font-size: 14px; letter-spacing: .16em; text-transform: uppercase; padding: 16px; border-radius: 999px; cursor: pointer; }
  .mb-cart__viewcart { display: block; text-align: center; margin-top: 12px; font-family: 'Space Mono', monospace; font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: #5B4373; }
</style>

<script>
  (function () {
    var root = document.getElementById('mb-cart');
    if (!root) return;
    var itemsEl = root.querySelector('#mb-cart-items');
    var emptyEl = root.querySelector('#mb-cart-empty');
    var footEl = root.querySelector('#mb-cart-foot');
    var subtotalEl = root.querySelector('#mb-cart-subtotal');

    function money(cents, currency) {
      try { return new Intl.NumberFormat(undefined, { style: 'currency', currency: currency || 'USD' }).format(cents / 100); }
      catch (e) { return '$' + (cents / 100).toFixed(2); }
    }
    function esc(s) { return (s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }

    function itemRow(item, currency) {
      var variant = (item.variant_title && item.variant_title !== 'Default Title') ? '<div class="mb-ci__variant">' + esc(item.variant_title) + '</div>' : '';
      var src = item.image ? item.image + (item.image.indexOf('?') > -1 ? '&' : '?') + 'width=140' : '';
      var img = item.image ? '<img class="mb-ci__img" src="' + src + '" alt="" width="68" height="78">' : '<div class="mb-ci__img mb-ci__img--ph"></div>';
      return '<div class="mb-ci" data-key="' + item.key + '">' + img +
        '<div class="mb-ci__info">' +
          '<a class="mb-ci__title" href="' + item.url + '">' + esc(item.product_title) + '</a>' + variant +
          '<div class="mb-ci__row">' +
            '<div class="mb-ci__qty"><button type="button" class="mb-ci__dec" aria-label="Decrease">&minus;</button><span class="mb-ci__q">' + item.quantity + '</span><button type="button" class="mb-ci__inc" aria-label="Increase">+</button></div>' +
            '<span class="mb-ci__price">' + money(item.final_line_price, currency) + '</span>' +
          '</div>' +
          '<button type="button" class="mb-ci__remove">Remove</button>' +
        '</div>' +
      '</div>';
    }

    function render(cart) {
      document.querySelectorAll('.mb-cart-count').forEach(function (el) { el.textContent = cart.item_count; });
      if (!cart.item_count) {
        itemsEl.innerHTML = ''; emptyEl.hidden = false; footEl.hidden = true;
      } else {
        itemsEl.innerHTML = cart.items.map(function (i) { return itemRow(i, cart.currency); }).join('');
        emptyEl.hidden = true; footEl.hidden = false;
        subtotalEl.textContent = money(cart.total_price, cart.currency);
      }
    }
    function refresh() { return fetch('/cart.js', { headers: { 'Accept': 'application/json' } }).then(function (r) { return r.json(); }).then(render); }
    function open() { root.classList.add('is-open'); root.setAttribute('aria-hidden', 'false'); document.documentElement.style.overflow = 'hidden'; }
    function close() { root.classList.remove('is-open'); root.setAttribute('aria-hidden', 'true'); document.documentElement.style.overflow = ''; }

    function changeQty(key, qty) {
      fetch('/cart/change.js', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ id: key, quantity: qty }) })
        .then(function (r) { return r.json(); }).then(render);
    }

    itemsEl.addEventListener('click', function (e) {
      var row = e.target.closest('.mb-ci'); if (!row) return;
      var key = row.getAttribute('data-key');
      var q = parseInt(row.querySelector('.mb-ci__q').textContent, 10) || 1;
      if (e.target.closest('.mb-ci__inc')) changeQty(key, q + 1);
      else if (e.target.closest('.mb-ci__dec')) changeQty(key, Math.max(0, q - 1));
      else if (e.target.closest('.mb-ci__remove')) changeQty(key, 0);
    });

    // Open on cart icon, close on overlay/X/Esc
    document.addEventListener('click', function (e) {
      if (e.target.closest('[data-mb-cart-open]')) { e.preventDefault(); open(); refresh(); }
      else if (e.target.closest('[data-mb-cart-close]')) { e.preventDefault(); close(); }
    });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });

    // Intercept every product add-to-cart form -> AJAX + open drawer
    document.addEventListener('submit', function (e) {
      var f = e.target;
      if (!f || !f.matches || !f.matches('form[action*="/cart/add"]')) return;
      e.preventDefault();
      var btn = f.querySelector('[type="submit"]');
      if (btn) btn.setAttribute('aria-busy', 'true');
      fetch('/cart/add.js', { method: 'POST', headers: { 'Accept': 'application/json' }, body: new FormData(f) })
        .then(function (r) { return r.json().then(function (j) { if (!r.ok) throw j; return j; }); })
        .then(function () { if (btn) btn.removeAttribute('aria-busy'); return refresh(); })
        .then(function () { open(); })
        .catch(function (err) { if (btn) btn.removeAttribute('aria-busy'); alert((err && err.description) || 'Sorry — could not add that to your cart.'); });
    });
  })();
</script>
