{%- comment -%}
  Free Shipping Progress Bar — Marlowe
  - Fill switches from `fill_color` to `fill_color_near` once progress >= switch_percent.
  - Dispatches `cart:threshold-reached` when the cart crosses the threshold (confetti listens).
  - Script gated by window.__fsbScriptLoaded so it runs once even if rendered in two places.
{%- endcomment -%}

{%- liquid
  assign threshold = threshold | default: 50
  assign progress_message = progress_message | default: 'Spend [amount] to unlock free shipping'
  assign success_message = success_message | default: 'You unlocked FREE shipping!'
  assign bg_color = bg_color | default: '#5B4373'
  assign text_color = text_color | default: '#FDF3EA'
  assign fill_color = fill_color | default: '#E8D8F8'
  assign fill_color_near = fill_color_near | default: '#A9CC7B'
  assign switch_percent = switch_percent | default: 50
  assign font_size = font_size | default: 15
  assign bar_height = bar_height | default: 8
  assign bar_max_width = bar_max_width | default: 420

  assign threshold_cents = threshold | times: 100
  assign cart_total = cart.total_price
  assign remaining = threshold_cents | minus: cart_total

  if threshold_cents <= 0
    assign progress_percent = 0
  elsif cart_total >= threshold_cents
    assign progress_percent = 100
  else
    assign progress_percent = cart_total | times: 100.0 | divided_by: threshold_cents
  endif

  assign active_fill = fill_color
  if progress_percent >= switch_percent
    assign active_fill = fill_color_near
  endif
-%}

<div
  class="fsb"
  data-fsb
  data-fsb-threshold="{{ threshold_cents }}"
  data-fsb-fill-color="{{ fill_color }}"
  data-fsb-fill-near="{{ fill_color_near }}"
  data-fsb-switch="{{ switch_percent }}"
  style="background: {{ bg_color }}; color: {{ text_color }}; padding: 12px 20px 14px; width: 100%; box-sizing: border-box; font-family: 'Space Mono', monospace; font-size: {{ font_size }}px; line-height: 1.3;"
>
  <p class="fsb__message" data-fsb-message style="margin: 0 0 10px; text-align: center; font-weight: 400; letter-spacing: .04em;">
    {%- if cart_total >= threshold_cents -%}
      {{ success_message }}
    {%- else -%}
      {%- assign remaining_formatted = remaining | money -%}
      {{ progress_message | replace: '[amount]', remaining_formatted }}
    {%- endif -%}
  </p>
  <div
    class="fsb__track"
    data-fsb-track
    style="display: block !important; height: {{ bar_height }}px !important; width: 100% !important; max-width: {{ bar_max_width }}px; margin: 0 auto !important; border-radius: 999px; background-color: rgba(255,255,255,0.28); background-image: linear-gradient(to right, {{ active_fill }} {{ progress_percent }}%, rgba(255,255,255,0.28) {{ progress_percent }}%); transition: background-image .35s ease;"
  ></div>
</div>

<script>
  (function () {
    if (window.__fsbScriptLoaded) return;
    window.__fsbScriptLoaded = true;

    var PROGRESS_TEMPLATE = {{ progress_message | json }};
    var SUCCESS_TEMPLATE = {{ success_message | json }};
    var MONEY_FORMAT = {{ shop.money_format | json }};
    var TRACK_EMPTY = 'rgba(255,255,255,0.28)';
    var previousCartTotal = null;

    function formatMoney(cents) {
      if (window.Shopify && typeof Shopify.formatMoney === 'function') {
        try { return Shopify.formatMoney(cents, MONEY_FORMAT); } catch (e) {}
      }
      return '$' + (cents / 100).toFixed(2);
    }

    function getCanonicalThreshold() {
      var bars = document.querySelectorAll('[data-fsb]');
      for (var i = 0; i < bars.length; i++) {
        var t = parseInt(bars[i].getAttribute('data-fsb-threshold'), 10);
        if (t > 0) return t;
      }
      return null;
    }

    function checkThresholdCrossing(newTotalCents) {
      var threshold = getCanonicalThreshold();
      if (!threshold) return;
      if (previousCartTotal === null) return;
      if (previousCartTotal < threshold && newTotalCents >= threshold) {
        document.dispatchEvent(new CustomEvent('cart:threshold-reached', {
          detail: { threshold: threshold, total: newTotalCents }
        }));
      }
    }

    function render(totalCents) {
      var bars = document.querySelectorAll('[data-fsb]');
      for (var i = 0; i < bars.length; i++) {
        var bar = bars[i];
        var threshold = parseInt(bar.getAttribute('data-fsb-threshold'), 10);
        if (!threshold) continue;
        var baseFill = bar.getAttribute('data-fsb-fill-color') || '#E8D8F8';
        var nearFill = bar.getAttribute('data-fsb-fill-near') || '#A9CC7B';
        var switchAt = parseFloat(bar.getAttribute('data-fsb-switch')) || 50;
        var percent = Math.min(100, Math.max(0, (totalCents / threshold) * 100));
        var fillColor = percent >= switchAt ? nearFill : baseFill;
        var track = bar.querySelector('[data-fsb-track]');
        if (track) {
          track.style.backgroundImage =
            'linear-gradient(to right, ' + fillColor + ' ' + percent + '%, ' + TRACK_EMPTY + ' ' + percent + '%)';
        }
        var message = bar.querySelector('[data-fsb-message]');
        if (!message) continue;
        if (totalCents >= threshold) {
          message.textContent = SUCCESS_TEMPLATE;
        } else {
          message.textContent = PROGRESS_TEMPLATE.replace('[amount]', formatMoney(threshold - totalCents));
        }
      }
    }

    function refresh() {
      fetch('/cart.js', { credentials: 'same-origin', cache: 'no-store' })
        .then(function (r) { return r.json(); })
        .then(function (cart) {
          checkThresholdCrossing(cart.total_price);
          previousCartTotal = cart.total_price;
          render(cart.total_price);
        })
        .catch(function () {});
    }

    refresh();

    ['cart:refresh', 'cart:updated', 'cart-drawer:updated', 'cart:change',
     'cart:added', 'cart:item-added', 'cart-update'].forEach(function (evt) {
      document.addEventListener(evt, refresh);
    });

    if (!window.__fsbInstrumented) {
      window.__fsbInstrumented = true;
      var CART_URL_RE = /\/cart\/(add|change|update|clear)(\.js)?/;
      var origFetch = window.fetch;
      window.fetch = function () {
        var arg0 = arguments[0];
        var url = (arg0 && arg0.url) ? arg0.url : arg0;
        var result = origFetch.apply(this, arguments);
        if (typeof url === 'string' && CART_URL_RE.test(url)) {
          result.then(function () { setTimeout(function () { document.dispatchEvent(new CustomEvent('cart:refresh')); }, 60); }).catch(function () {});
        }
        return result;
      };
      var origOpen = XMLHttpRequest.prototype.open;
      XMLHttpRequest.prototype.open = function (method, url) {
        this.addEventListener('load', function () {
          if (typeof url === 'string' && CART_URL_RE.test(url)) {
            setTimeout(function () { document.dispatchEvent(new CustomEvent('cart:refresh')); }, 60);
          }
        });
        return origOpen.apply(this, arguments);
      };
    }
  })();
</script>
